# Private PostgreSQL database owned by Retro; plain PostgreSQL, no extensions required.
DATABASE_URL=postgres://retro:replace-me@127.0.0.1:5432/retro?sslmode=disable
LISTEN_ADDR=127.0.0.1:8092
TRUSTED_ORIGINS=

# All four MinIO values are required to enable photos. Never use root credentials in production.
# Endpoint is the S3 API origin, not the console endpoint. HTTP is explicit for local/private development.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=retro-photos
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_REGION=us-east-1
